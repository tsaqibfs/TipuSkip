<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tipuskip.controller.SimulasiPesanController"
            stylesheets="@../css/style.css">

    <!-- Left Sidebar: Skenario Selector & Realtime Stats -->
    <left>
        <VBox spacing="14" prefWidth="320" styleClass="card">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
            <Label text="💬 Simulasi Pesan Interaktif" styleClass="card-title" />
            <Label text="Pilih skenario percakapan penipuan digital untuk menguji ketangkasan Anda." styleClass="card-subtitle" wrapText="true" />

            <Separator />

            <Label text="Pilih Skenario:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1e293b;" />
            <ComboBox fx:id="cbSkenario" promptText="-- Pilih Skenario Pesan --" maxWidth="Infinity" style="-fx-cursor: hand;" />

            <!-- Scenario Metadata Box -->
            <VBox fx:id="infoCard" spacing="6" style="-fx-background-color: #f8fafc; -fx-padding: 12px; -fx-background-radius: 8px; -fx-border-color: #e2e8f0; -fx-border-radius: 8px;">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label fx:id="lblKategori" text="Kategori: -" styleClass="edu-tag" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblKesulitan" text="MUDAH" styleClass="badge-rendah" />
                </HBox>
                <Label fx:id="lblDeskripsi" text="Silakan pilih skenario untuk memulai simulasi." wrapText="true" style="-fx-text-fill: #475569; -fx-font-size: 12px;" />
            </VBox>

            <HBox spacing="8">
                <Button fx:id="btnMulaiSimulasi" text="▶ Mulai Simulasi" onAction="#handleMulaiSimulasi" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="btn-primary" />
                <Button fx:id="btnReset" text="🔄 Reset" onAction="#handleReset" styleClass="btn-secondary" />
            </HBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Progress & Live Score Box -->
            <VBox spacing="8" style="-fx-background-color: #eff6ff; -fx-padding: 12px; -fx-background-radius: 10px; -fx-border-color: #bfdbfe; -fx-border-radius: 10px;">
                <HBox alignment="CENTER_LEFT">
                    <Label text="Status Langkah:" style="-fx-font-size: 11px; -fx-text-fill: #1e40af; -fx-font-weight: bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblProgressLangkah" text="Langkah: -" style="-fx-font-size: 11px; -fx-text-fill: #2563eb; -fx-font-weight: bold;" />
                </HBox>
                <Separator />
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2">
                        <Label text="Skor Keamanan" style="-fx-font-size: 11px; -fx-text-fill: #1e40af; -fx-font-weight: bold;" />
                        <Label fx:id="lblSkorLive" text="100 / 100" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1d4ed8;" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblSkorStatus" text="🛡️ AMAN" styleClass="badge-rendah" />
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- Center: Authentic WhatsApp/Telegram-style Simulation -->
    <center>
        <VBox spacing="14" style="-fx-padding: 0 0 0 16;">
            <!-- Chat Window Container -->
            <VBox VBox.vgrow="ALWAYS" styleClass="chat-window">
                <!-- Chat Window Top Header -->
                <HBox alignment="CENTER_LEFT" spacing="12" styleClass="chat-header">
                    <StackPane styleClass="chat-avatar-circle">
                        <Label fx:id="lblAvatarText" text="👤" style="-fx-font-size: 18px; -fx-text-fill: #ffffff;" />
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="lblChatHeaderName" text="Pilih Skenario untuk Memulai" styleClass="chat-header-title" />
                        <Label fx:id="lblChatHeaderStatus" text="Nomor Tidak Dikenal (+62-XXX) • Simulasi Aman" styleClass="chat-header-status" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="🔒 Enkripsi Simulasi Edukasi" style="-fx-text-fill: #a7f3d0; -fx-font-size: 11px;" />
                </HBox>

                <!-- Scrollable Chat Bubble Area -->
                <ScrollPane fx:id="chatScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 12px;">
                    <VBox fx:id="chatBox" spacing="14" style="-fx-padding: 8px;">
                        <!-- Bubbles dynamically added -->
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- Feedback & Consequences Banner -->
            <VBox fx:id="feedbackBox" visible="false" managed="false" spacing="4"
                  style="-fx-padding: 12px; -fx-background-radius: 8px; -fx-border-radius: 8px;">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="lblFeedbackIcon" text="💡" style="-fx-font-size: 16px;" />
                    <Label fx:id="lblFeedbackJudul" text="Umpan Balik Respons" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
                </HBox>
                <Label fx:id="lblFeedbackDetail" text="Penjelasan konsekuensi atas pilihan Anda..." wrapText="true" />
            </VBox>

            <!-- User Response Choices Container -->
            <VBox fx:id="responsesContainer" spacing="8" styleClass="card">
                <HBox alignment="CENTER_LEFT">
                    <Label text="💬 Tentukan Balasan Respons Anda:" style="-fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label text="Pilih opsi yang paling aman dan logis" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
                </HBox>
                <VBox fx:id="choiceButtonsBox" spacing="8">
                    <!-- Dynamic choice buttons inserted here -->
                </VBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>
