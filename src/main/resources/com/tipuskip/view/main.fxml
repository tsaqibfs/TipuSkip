<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tipuskip.controller.MainController"
            prefHeight="750.0" prefWidth="1100.0"
            styleClass="app-root-pane"
            stylesheets="@../css/style.css">

    <!-- Top Integrated Header: Custom Title Bar & Navigation Bar -->
    <top>
        <VBox styleClass="integrated-header-container">
            <!-- Row 1: Custom Integrated Title Bar (Menyatu, Draggable, Window Actions) -->
            <HBox fx:id="customTitleBar" styleClass="custom-title-bar" alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="titlebar-left">
                    <ImageView fitWidth="20.0" fitHeight="20.0" preserveRatio="true">
                        <Image url="@../images/app-icon-32.png" />
                    </ImageView>
                    <Label text="TipuSkip" styleClass="titlebar-brand" />
                    <Label text="•" styleClass="titlebar-divider-dot" />
                    <Label text="Edukasi Pencegahan Penipuan Digital" styleClass="titlebar-tagline" />
                </HBox>

                <!-- Center Draggable Region -->
                <Region fx:id="titleBarDragSpacer" HBox.hgrow="ALWAYS" />

                <!-- Security & System Status Pill in Title Bar -->
                <HBox alignment="CENTER" spacing="6" styleClass="titlebar-security-pill">
                    <Label text="🛡️" style="-fx-font-size: 11px;" />
                    <Label text="Simulasi Interaktif PBO" styleClass="titlebar-security-text" />
                </HBox>

                <!-- Window Control Buttons (Minimize, Maximize/Restore, Close) -->
                <HBox alignment="CENTER_RIGHT" spacing="0" styleClass="window-controls-container">
                    <Button fx:id="btnWinMinimize" text="—" onAction="#handleWindowMinimize" styleClass="win-ctrl-btn, win-btn-minimize" focusTraversable="false" />
                    <Button fx:id="btnWinMaximize" text="▢" onAction="#handleWindowMaximize" styleClass="win-ctrl-btn, win-btn-maximize" focusTraversable="false" />
                    <Button fx:id="btnWinClose" text="✕" onAction="#handleWindowClose" styleClass="win-ctrl-btn, win-btn-close" focusTraversable="false" />
                </HBox>
            </HBox>

            <!-- Row 2: Main Navigation Bar -->
            <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="btnNavPesan" text="💬 Simulasi Pesan" onAction="#handleNavPesan" styleClass="nav-button" />
                <Button fx:id="btnNavTelepon" text="📞 Simulasi Telepon" onAction="#handleNavTelepon" styleClass="nav-button" />
                <Button fx:id="btnNavAnalisis" text="🔍 Analisis Tangkapan Layar" onAction="#handleNavAnalisis" styleClass="nav-button" />
                <Button fx:id="btnNavEdukasi" text="📚 Modul Edukasi" onAction="#handleNavEdukasi" styleClass="nav-button" />
                <Button fx:id="btnNavRiwayat" text="📜 Riwayat Aktivitas" onAction="#handleNavRiwayat" styleClass="nav-button" />
                <Button fx:id="btnNavAdmin" text="⚙️ Admin Panel" onAction="#handleNavAdmin" styleClass="nav-button" />
            </HBox>
        </VBox>
    </top>

    <!-- Content Center StackPane -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 16px;">
            <!-- Dynamic view loaded here -->
        </StackPane>
    </center>

    <!-- Bottom Desktop Status Bar -->
    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="🟢" style="-fx-font-size: 9px;" />
                <Label text="Sistem Siap" styleClass="status-label-bold" />
            </HBox>
            <Separator orientation="VERTICAL" />
            <Label text="Mode: Standalone / Mock Engine" styleClass="status-label" />
            <Separator orientation="VERTICAL" />
            <Label text="Pintasan: [Ctrl+1..6] Navigasi • [F1] Edukasi • [Ctrl+Q] Keluar" styleClass="status-label" />

            <Region HBox.hgrow="ALWAYS" />

            <Button text="ℹ️ Tentang Aplikasi" onAction="#handleTentangAplikasi" styleClass="btn-status-about" />
            <Label text="v1.0.0 (Custom UI Edition)" styleClass="status-label" />
        </HBox>
    </bottom>

</BorderPane>
