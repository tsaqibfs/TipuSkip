                            <VBox style="-fx-background-color: #f8fafc; -fx-padding: 12px; -fx-background-radius: 8px;" spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Cek Rekening Kominfo" style="-fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                                <Label text="cekrekening.id" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;" />
                                <Label text="Cek &amp; Laporkan Rekening Penipu" style="-fx-text-fill: #64748b; -fx-font-size: 11px;" />
