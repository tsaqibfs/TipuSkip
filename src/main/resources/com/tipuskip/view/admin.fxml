<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tipuskip.controller.AdminController"
      spacing="16" stylesheets="@../css/style.css">

    <Label text="⚙️ Admin Panel - Pengelolaan Skenario &amp; Indikator" styleClass="card-title" />

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- Tab 1: Kelola Skenario (FR-12) -->
        <Tab text="Kelola Skenario">
            <VBox spacing="12" style="-fx-padding: 16px;">
                <HBox spacing="16">
                    <!-- Left: Table of Scenarios -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Daftar Skenario Simulasi:" style="-fx-font-weight: bold;" />
                        <TableView fx:id="tableSkenario" prefHeight="300">
                            <columns>
                                <TableColumn fx:id="colSkId" text="ID" prefWidth="40" />
                                <TableColumn fx:id="colSkJudul" text="Judul" prefWidth="200" />
                                <TableColumn fx:id="colSkJenis" text="Jenis" prefWidth="90" />
                                <TableColumn fx:id="colSkKategori" text="Kategori" prefWidth="130" />
                                <TableColumn fx:id="colSkTingkat" text="Kesulitan" prefWidth="90" />
                                <TableColumn fx:id="colSkStatus" text="Aktif" prefWidth="60" />
                            </columns>
                        </TableView>
                        <HBox spacing="8">
                            <Button text="🗑 Hapus Skenario" onAction="#handleHapusSkenario" styleClass="btn-danger" />
                            <Button text="⚡ Ubah Status Aktif" onAction="#handleToggleStatusSkenario" styleClass="btn-secondary" />
                            <Button text="🔄 Refresh" onAction="#muatDataSkenario" styleClass="btn-secondary" />
                        </HBox>
                    </VBox>

                    <!-- Right: Form Tambah/Ubah Skenario -->
                    <VBox spacing="10" prefWidth="350" styleClass="card">
                        <Label fx:id="lblFormSkenario" text="Kelola Skenario (Tambah / Ubah)" styleClass="card-title" />
                        <TextField fx:id="txtSkJudul" promptText="Judul Skenario" />
                        <TextArea fx:id="txtSkDeskripsi" promptText="Deskripsi Skenario" prefHeight="60" wrapText="true" />
                        <ComboBox fx:id="cbSkJenis" promptText="Jenis (PESAN / TELEPON)" maxWidth="Infinity" />
                        <TextField fx:id="txtSkKategori" promptText="Kategori (e.g. Lowongan Kerja)" />
                        <ComboBox fx:id="cbSkTingkat" promptText="Tingkat Kesulitan" maxWidth="Infinity" />
                        <HBox spacing="8">
                            <Button text="💾 Simpan Baru" onAction="#handleTambahSkenario" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary" />
                            <Button text="✏️ Perbarui" onAction="#handleUbahSkenario" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary" />
                        </HBox>
                        <Button text="❌ Bersihkan Form" onAction="#handleResetFormSkenario" maxWidth="Infinity" styleClass="btn-secondary" />
                    </VBox>
                </HBox>
            </VBox>
        </Tab>

        <!-- Tab 2: Kelola Indikator Penipuan (FR-13) -->
        <Tab text="Kelola Indikator Penipuan">
            <VBox spacing="12" style="-fx-padding: 16px;">
                <HBox spacing="16">
                    <!-- Left: Table of Indicators -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <Label text="Daftar Indikator Pola &amp; Regex:" style="-fx-font-weight: bold;" />
                        <TableView fx:id="tableIndikator" prefHeight="300">
                            <columns>
                                <TableColumn fx:id="colIndId" text="ID" prefWidth="40" />
                                <TableColumn fx:id="colIndNama" text="Nama Indikator" prefWidth="180" />
                                <TableColumn fx:id="colIndPola" text="Pola / Regex" prefWidth="180" />
                                <TableColumn fx:id="colIndTipe" text="Tipe" prefWidth="80" />
                                <TableColumn fx:id="colIndBobot" text="Bobot" prefWidth="60" />
                                <TableColumn fx:id="colIndStatus" text="Aktif" prefWidth="60" />
                            </columns>
                        </TableView>
                        <HBox spacing="8">
                            <Button text="🗑 Hapus Indikator" onAction="#handleHapusIndikator" styleClass="btn-danger" />
                            <Button text="⚡ Ubah Status Aktif" onAction="#handleToggleStatusIndikator" styleClass="btn-secondary" />
                            <Button text="🔄 Refresh" onAction="#muatDataIndikator" styleClass="btn-secondary" />
                        </HBox>
                    </VBox>

                    <!-- Right: Form Tambah/Ubah Indikator Baru -->
                    <VBox spacing="10" prefWidth="350" styleClass="card">
                        <Label fx:id="lblFormIndikator" text="Kelola Indikator (Tambah / Ubah)" styleClass="card-title" />
                        <TextField fx:id="txtIndNama" promptText="Nama Indikator" />
                        <TextField fx:id="txtIndPola" promptText="Pola Regex / Kata Kunci" />
                        <ComboBox fx:id="cbIndTipe" promptText="Tipe (KEYWORD / REGEX)" maxWidth="Infinity" />
                        <Spinner fx:id="spnIndBobot" editable="true" maxWidth="Infinity" />
                        <TextArea fx:id="txtIndDeskripsi" promptText="Deskripsi Analisis" prefHeight="50" wrapText="true" />
                        <TextArea fx:id="txtIndSaran" promptText="Saran Verifikasi Aman" prefHeight="50" wrapText="true" />
                        <HBox spacing="8">
                            <Button text="💾 Simpan Baru" onAction="#handleTambahIndikator" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-primary" />
                            <Button text="✏️ Perbarui" onAction="#handleUbahIndikator" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="btn-secondary" />
                        </HBox>
                        <Button text="❌ Bersihkan Form" onAction="#handleResetFormIndikator" maxWidth="Infinity" styleClass="btn-secondary" />
                    </VBox>
                </HBox>
            </VBox>
        </Tab>

    </TabPane>
</VBox>
